# ── Database ────────────────────────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL="file:./prisma/dev.db"
# MySQL for PlanetHoster production (replace values):
# DATABASE_URL="mysql://DB_USER:DB_PASS@localhost:3306/wshm_db"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-char-string"
# Must match the public URL of your site (no trailing slash)
NEXTAUTH_URL="https://wshm.ma"

# ── Site URL (used in SEO / sitemap) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://wshm.ma"

# ── File uploads ─────────────────────────────────────────────────────────────
# Absolute path where uploaded files are stored on disk.
# On PlanetHoster set this to the full path of your public/uploads folder,
# e.g. /home/username/public_html/wshmadagh/public/uploads
# Leave empty to use the default: <project_root>/public/uploads
UPLOAD_DIR=""
