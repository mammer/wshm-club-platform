generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// LOCAL DEV: provider = "sqlite", DATABASE_URL="file:./prisma/dev.db"
// PRODUCTION: change to provider = "mysql", DATABASE_URL="mysql://user:pass@localhost/wshm_db"
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id            String    @id @default(cuid())
  fullName      String
  photoUrl      String?
  category      String    // MINIMES | CADETS | JUNIORS | SENIORS
  position      String?
  licenseNumber String?   @unique
  birthDate     DateTime?
  phone         String?
  jerseyNumber  Int?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  // Identity
  cin           String?
  nationality   String?   @default("Marocaine")
  address       String?
  // Guardian (for minors: Minimes, Cadets, Juniors)
  parentName    String?
  parentPhone   String?
  parentCin     String?
  // Medical
  medicalDate   DateTime?
  // Notes
  notes         String?
  payments          Payment[]
  attendanceRecords AttendanceRecord[]
  stats             PlayerStat[]
}

model Coach {
  id         String    @id @default(cuid())
  fullName   String
  photoUrl   String?
  role       String
  category   String    // MINIMES | CADETS | JUNIORS | SENIORS
  license    String?
  phone      String?
  // Identity
  cin        String?
  birthDate  DateTime?
  address    String?
  nationality String?  @default("Marocaine")
  experience  String?  // ex: "8 ans d'expérience"
  // Medical
  medicalDate DateTime?
  notes      String?
}

model Match {
  id          String       @id @default(cuid())
  category    String
  homeTeam    String
  awayTeam    String
  homeScore   Int?
  awayScore   Int?
  matchDate   DateTime
  location    String?
  matchday    Int?
  competition String       @default("CHAMPIONNAT")
  stats       PlayerStat[]
}

model Meeting {
  id            String   @id @default(cuid())
  title         String
  meetingDate   DateTime
  location      String?
  agenda        String?
  notes         String?
  decisions     String?
  attendeeCount Int?
  documentUrl   String?
  createdAt     DateTime @default(now())
}

model Payment {
  id          String   @id @default(cuid())
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId    String
  amount      Decimal
  paymentDate DateTime
  paymentType String   // COTISATION | LICENCE | EQUIPEMENT | AUTRE
  season      String
  notes       String?
  recordedBy  String?
}

model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  titleFr       String
  titleAr       String
  contentFr     String
  contentAr     String
  coverImageUrl String?
  author        String
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
}

model Tournament {
  id                   String                   @id @default(cuid())
  nameFr               String
  nameAr               String
  tournamentDate       DateTime
  registrationDeadline DateTime?
  categories           String
  descriptionFr        String?
  descriptionAr        String?
  isOpen               Boolean                  @default(false)
  registrations        TournamentRegistration[]
}

model TournamentRegistration {
  id                  String     @id @default(cuid())
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId        String
  clubName            String?
  clubAddress         String?
  clubCity            String?
  presidentName       String?
  contactName         String
  contactPhone        String
  contactEmail        String?
  coachName           String?
  coachLicense        String?
  category            String
  playerCount         Int
  ageGroupMin         Int?       // youngest player age
  ageGroupMax         Int?       // oldest player age
  hasMedicalCerts     Boolean    @default(false)
  paymentMethod       String?    // ESPECES | VIREMENT | CHEQUE
  notes               String?
  status              String     @default("PENDING") // PENDING | CONFIRMED | REJECTED
  createdAt           DateTime   @default(now())
}

model GalleryPhoto {
  id        String    @id @default(cuid())
  titleFr   String?
  titleAr   String?
  imageUrl  String
  category  String?
  eventDate DateTime?
  createdAt DateTime  @default(now())
}

model AdminUser {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  name     String
  role     String  @default("ADMIN") // ADMIN | SECRETARY | AUTHOR | COACH
  photoUrl String?
}

model Expense {
  id          String   @id @default(cuid())
  category    String   // TRANSPORT | ALIMENTATION | DEPLACEMENT | SALAIRES | EQUIPEMENT | ARBITRAGE | ADMINISTRATION | AUTRE
  amount      Decimal
  expenseDate DateTime
  description String
  vendor      String?
  paidBy      String?
  receiptUrl  String?
  season      String
  notes       String?
  createdAt   DateTime @default(now())
}

model ClubSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Sponsor {
  id        String    @id @default(cuid())
  name      String
  logoUrl   String?
  amount    Decimal
  startDate DateTime
  endDate   DateTime?
  tier      String    @default("BRONZE") // OR | ARGENT | BRONZE
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Attendance {
  id          String             @id @default(cuid())
  sessionDate DateTime
  sessionType String             // ENTRAINEMENT | MATCH
  category    String
  notes       String?
  records     AttendanceRecord[]
  createdAt   DateTime           @default(now())
}

model AttendanceRecord {
  id            String     @id @default(cuid())
  session       Attendance @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  player        Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      String
  present       Boolean    @default(false)
  justification String?
}

model PlayerStat {
  id            String   @id @default(cuid())
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      String
  match         Match?   @relation(fields: [matchId], references: [id])
  matchId       String?
  season        String
  goals         Int      @default(0)
  assists       Int      @default(0)
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)
  minutesPlayed Int?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CREATE | UPDATE | DELETE
  entity    String
  entityId  String?
  details   String?
  userName  String?
  createdAt DateTime @default(now())
}

model Archive {
  id          String   @id @default(cuid())
  title       String
  category    String   // REUNION | JURIDIQUE | STATUTS | CONTRAT | CORRESPONDANCE | FINANCIER | AUTRE
  fileUrl     String
  fileType    String   // pdf | docx | xlsx | jpg | png | other
  fileSize    Int?
  description String?
  year        Int?
  uploadedBy  String?
  createdAt   DateTime @default(now())
}

model Member {
  id          String    @id @default(cuid())
  fullName    String
  role        String    @default("MEMBER") // PRESIDENT | VICE_PRESIDENT | SECRETARY | TREASURER | MEMBER | HONORARY
  phone       String?
  email       String?
  address     String?
  birthDate   DateTime?
  joinDate    DateTime  @default(now())
  photoUrl    String?
  cin         String?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}
